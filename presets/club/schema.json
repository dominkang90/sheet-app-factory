  "scale": { "members": 30, "note": "앱스크립트는 수십 명까지 넉넉함. 수백 명이 동시에 쓰면 다른 저장소를 검토" },
  "privacy": { "collectPhone": false, "keepMonths": 12, "photosPublic": false },
