        { "h": "이름", "type": "text", "req": true },
        { "h": "역할", "type": "text", "hint": "여러 개면 쉼표로: 총무, 사진" },
        { "h": "상태", "type": "select", "options": ["활동", "쉬는 중"] } ] },
