    { "key": "audio", "name": "03_녹음", "byDate": true, "label": "녹음", "write": ["대표", "기록"], "accept": "audio/*,.m4a,.mp3,.wav" },
    { "key": "doc", "name": "04_문서", "label": "문서", "write": ["대표"] },
    { "key": "archive", "name": "99_보관" }
