        { "h": "이름", "type": "user" },
        { "h": "응답", "type": "select", "options": ["참석", "불참"], "req": true },
        { "h": "게스트", "type": "number", "hint": "데려오는 사람 수 (최대 2)" } ] },
    { "key": "money", "name": "돈", "title": "항목", "date": "날짜", "write": ["대표", "총무"], "read": ["대표", "총무"], "sum": "금액",
      "columns": [
        { "h": "날짜", "type": "date", "req": true },
        { "h": "항목", "type": "text", "req": true },
        { "h": "금액", "type": "money", "req": true },
        { "h": "메모", "type": "longtext" },
        { "h": "올린사람", "type": "user" } ] },
    { "key": "board", "name": "게시판", "title": "제목", "write": "own",
      "columns": [
        { "h": "시간", "type": "datetime", "auto": true },
        { "h": "작성자", "type": "user" },
        { "h": "제목", "type": "text", "req": true },
        { "h": "내용", "type": "longtext" } ] },
    { "key": "log", "name": "기록", "system": true,
      "columns": [ { "h": "시간", "type": "text" }, { "h": "이름", "type": "text" }, { "h": "일", "type": "text" }, { "h": "내용", "type": "text" } ] }
  ],
  "folders": [
    { "key": "upload", "name": "00_업로드" },
